# ─────────────────────────────────────────────
# million-top-projects — environment variables
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────

# Google Service Account (same credentials as price_lists_update app)
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Spreadsheet IDs (copy from Railway env vars in price_lists_update)
# ESQUELETO_SPREADSHEET_ID  = PROJECT_INFO_SPREADSHEET_ID in the main app
# TP_DATA_SPREADSHEET_ID    = PROJECT_INFO_LOG_SPREADSHEET_ID in the main app
ESQUELETO_SPREADSHEET_ID=replace_me
TP_DATA_SPREADSHEET_ID=replace_me

# seed-renders.js — comma-separated IDs of the Drive folders that contain
# one subfolder per project (each project subfolder has a "Renders" sub-subfolder)
RENDERS_FOLDER_IDS=replace_me

# seed-docs-from-drive.js — top-level Drive folder containing one subfolder
# per project, each with Brochure / Fact Sheet / Floor Plans / Presentation / Renderings subfolders
DOCS_DRIVE_FOLDER_ID=replace_me

# seed-pricelists-from-drive.js — top-level folder organized as:
#   Price List {YEAR}/ → Price List {N} ({Month})/ → {ProjectName} - Price List {N}.pdf
PRICE_LIST_DRIVE_FOLDER_ID=replace_me

# Pre-construction Data spreadsheet ID (col F = Price List, col G = Price Range)
# Defaults to the known ID if not set; override here if the spreadsheet ever moves
# PRE_CONSTRUCTION_SPREADSHEET_ID=1RTDA5ZNHbHrSYTEVGuUCUdWI04TKRso--ErWmASEehU

# ── Google OAuth (runtime auth — required for deployed site) ──────────────────
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create → OAuth 2.0 Client ID → Application type: Web application
# 3. Add Authorized JavaScript origins:
#      http://localhost:3000  (local dev)
#      https://<your-domain>.vercel.app  (production)
# 4. Copy the Client ID below (the Client Secret is NOT needed for this flow)
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com

# Company email domain — only users with this domain can log in
ALLOWED_DOMAIN=replace_me.com

# Random secret for signing session cookies — generate with: openssl rand -base64 32
SESSION_SECRET=replace_me
